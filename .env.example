# RESONA Environment Configuration

# App
APP_ENV=development
DEBUG=true
SECRET_KEY=resona_secret_key_change_in_production
API_V1_PREFIX=/api/v1

# Database (PostgreSQL 16 with pgvector & pg_trgm)
POSTGRES_USER=resona_user
POSTGRES_PASSWORD=resona_password
POSTGRES_DB=resona_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://resona_user:resona_password@localhost:5432/resona_db

# Fallback Database for zero-config local testing (if PostgreSQL unavailable)
USE_SQLITE_FALLBACK_IF_PG_UNAVAILABLE=true
SQLITE_DB_URL=sqlite:///./resona_local.db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Hindsight Experiential Memory Layer
# When credentials are provided, RESONA uses official Hindsight Cloud/Self-Hosted API.
# When omitted, Hindsight Service runs in isolated Local Fallback Memory mode with explicit health reporting.
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.ai/v1
HINDSIGHT_BANK_ID=resona_materials_memory
HINDSIGHT_TIMEOUT=10.0

# Embedding Service
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Memory Evaluation / Hackathon Mode
MEMORY_MODE_ENABLED=true
